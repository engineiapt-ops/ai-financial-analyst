# =============================================================================
# AI Financial Analyst — Configuração (alinhar com o código)
# =============================================================================
# cp .env.example .env

# --- Obrigatório ---
DATABASE_URL=
API_AUTH_TOKEN=

# --- Mercado (Binance) ---
BINANCE_REST_BASE=
BINANCE_WS_BASE=

# --- Jev / AI Gateway (nomes reais usados em src/jev/jevClient.ts) ---
AI_GATEWAY_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# Para reprodutibilidade de backtest, fixe um identificador legível e grave-o em cada run.
# "gateway-managed" NÃO pina o modelo no gateway.
JEV_MODEL_VERSION=gateway-managed

# --- Thresholds (opcional; defaults no código: 0.68 / 0.62 / 1.5%) ---
# DECISION_MIN_CONFIDENCE=0.68
# DECISION_MIN_PROBABILIDADE=0.62
# DECISION_BLOQUEAR_RISCO_ELEVADO=true
# FIXED_POSITION_PCT=1.5

# --- Gemini (opcional — só narrativa; NÃO decide) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE=
GEMINI_TIMEOUT_MS=

# --- Sentimento / research (opcional) ---
CRYPTOPANIC_API_KEY=
GDELT_BASE_URL=

# --- API ---
PORT=3000
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_HEAVY_MAX=20
OBSERVABILITY_LOGS=true
