# Binance REST base URL
BINANCE_REST_BASE=
# Binance WebSocket base URL
BINANCE_WS_BASE=
# CryptoPanic API key
CRYPTOPANIC_API_KEY=
# PostgreSQL connection string
DATABASE_URL=

# JEV gateway base URL
JEV_BASE_URL=
# Expected gateway-reported JEV model/version
JEV_MODEL_VERSION=
# AI Gateway API key
AI_GATEWAY_API_KEY=

# Gemini API key
GEMINI_API_KEY=
# Gemini model identifier
GEMINI_MODEL=gemini-3.8-flash
# Gemini text-to-speech model identifier
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Gemini API base URL
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Gemini request timeout in milliseconds
GEMINI_TIMEOUT_MS=30000
# Optional Google API key fallback
GOOGLE_API_KEY=

# Express proxy trust setting
TRUST_PROXY=false
# Standard API rate limit per minute
RATE_LIMIT_MAX=120
# Heavy API rate limit per minute
RATE_LIMIT_HEAVY_MAX=20
# API authentication token
API_AUTH_TOKEN=
# Enable structured observability logs
OBSERVABILITY_LOGS=true
# Enable demo behavior
AI_DEMO_MODE=false
# Legacy stock analyst routes stay disabled unless explicitly enabled
ENABLE_STOCK_ANALYST=false
# Comma-separated allowed browser origins; empty is same-origin-only in production
CORS_ORIGINS=
# Frontend backend origin; leave empty for same-origin development
VITE_API_BASE_URL=
# Server port
PORT=3000
# Runtime environment
NODE_ENV=development

# Vercel deployment marker
VERCEL=
# Vercel OIDC token
VERCEL_OIDC_TOKEN=

# Cron authentication secret
CRON_SECRET=
# Enable automatic paper JEV cycle
PAPER_JEV_AUTORUN=true
# Minimum deterministic decision confidence
DECISION_MIN_CONFIDENCE=0.68
# Minimum directional probability
DECISION_MIN_PROBABILIDADE=0.62
# Block trades when elevated risk is detected
DECISION_BLOQUEAR_RISCO_ELEVADO=true
# Fixed paper position size percentage
FIXED_POSITION_PCT=1.5

# IG demo market-data API
IG_API_BASE_URL=https://demo-api.ig.com/gateway/deal
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=


# Saxo OpenAPI environment: sim or live
SAXO_ENVIRONMENT=sim
# Explicit safety switch required before any Saxo LIVE read-only connection is constructed
SAXO_ENABLE_LIVE_READ_ONLY=false
# Saxo OpenAPI access token; never commit a real token
SAXO_ACCESS_TOKEN=
# Minimum spacing between outbound Saxo REST requests
SAXO_MIN_REQUEST_INTERVAL_MS=1000
