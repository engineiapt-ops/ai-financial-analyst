# Binance REST base URL
BINANCE_REST_BASE=

# Binance WebSocket base URL
BINANCE_WS_BASE=

# CryptoPanic API key (sensitive)
CRYPTOPANIC_API_KEY=

# PostgreSQL connection string (sensitive)
DATABASE_URL=

# AI Gateway API key (sensitive)
AI_GATEWAY_API_KEY=

# Jev gateway base URL
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe

# Expected Jev model/version (blank to allow runtime reporting)
JEV_MODEL_VERSION=

# Gemini API key (sensitive)
GEMINI_API_KEY=

# Gemini text model
GEMINI_MODEL=gemini-3.8-flash

# Gemini API base URL
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Gemini request timeout in milliseconds
GEMINI_TIMEOUT_MS=30000

# API authentication token (sensitive)
API_AUTH_TOKEN=

# Cron authentication secret (sensitive)
CRON_SECRET=

# Jev paper-cycle autorun flag
PAPER_JEV_AUTORUN=false

# Deterministic decision minimum confidence
DECISION_MIN_CONFIDENCE=0.68

# Deterministic decision minimum directional probability
DECISION_MIN_PROBABILIDADE=0.62

# Block elevated-risk decisions
DECISION_BLOQUEAR_RISCO_ELEVADO=true

# Fixed paper position size percentage
FIXED_POSITION_PCT=1.5

# Reverse-proxy trust flag
TRUST_PROXY=false

# API requests per minute
RATE_LIMIT_MAX=120

# Heavy API requests per minute
RATE_LIMIT_HEAVY_MAX=20

# Structured observability logs
OBSERVABILITY_LOGS=true

# Demo-mode flag
AI_DEMO_MODE=false

# Google API key (sensitive, platform compatibility)
GOOGLE_API_KEY=

# Vercel runtime marker (normally platform-provided)
VERCEL=

# Vercel OIDC token (sensitive, platform-provided)
VERCEL_OIDC_TOKEN=

# Node runtime mode
NODE_ENV=development

# HTTP port
PORT=3000
