# =============================================================================
# AI Financial Analyst — Configuração para uso pessoal
# =============================================================================
# 1. Copie este arquivo:  cp .env.example .env
# 2. Preencha as variáveis obrigatórias
# 3. Rode: npm install && npm run db:migrate
# =============================================================================

# --- Obrigatório ---
# PostgreSQL (local ou cloud). Exemplo local:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_financial_analyst
DATABASE_URL=

# Token de autenticação da API (use uma string forte / UUID)
API_AUTH_TOKEN=

# --- Mercado (Binance) ---
# Deixe vazio para usar os endpoints oficiais da Binance Spot
BINANCE_REST_BASE=
BINANCE_WS_BASE=

# --- Modelo Jev ---
# Versão fixada do modelo. Não altere depois de começar validação OOS.
JEV_MODEL_VERSION=gateway-managed

# --- Thresholds de decisão (opcional — defaults conservadores já no código) ---
# Valores mais altos = mais seletivo (mais WAIT). Não mude depois de congelar.
# DECISION_MIN_CONFIDENCE=0.68
# DECISION_MIN_PROBABILIDADE=0.62
# DECISION_BLOQUEAR_RISCO_ELEVADO=true
# FIXED_POSITION_PCT=1.5

# --- Gemini (opcional — só narrativa/contexto, NÃO decide a operação) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000

# --- Fontes de sentimento / research (opcional) ---
CRYPTOPANIC_API_KEY=
GDELT_BASE_URL=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# --- API / Segurança / Observabilidade ---
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_HEAVY_MAX=20
OBSERVABILITY_LOGS=true
