# Binance market-data endpoints
BINANCE_REST_BASE=
BINANCE_WS_BASE=

# External research provider credential
CRYPTOPANIC_API_KEY=

# Server-side PostgreSQL connection
DATABASE_URL=

# JEV gateway credential
AI_GATEWAY_API_KEY=

# JEV gateway base URL
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe

# Expected effective JEV model/version; blank means record the gateway value without enforcing equality
JEV_MODEL_VERSION=

# Supplied by Vercel for OIDC-based gateway auth when available
VERCEL_OIDC_TOKEN=

# API authentication secret
API_AUTH_TOKEN=

# Scheduled JEV cycle secret
CRON_SECRET=

# Enable controlled JEV paper sampling (must remain false until intentionally enabled)
PAPER_JEV_AUTORUN=false

# Deterministic decision thresholds
DECISION_MIN_CONFIDENCE=0.68
DECISION_MIN_PROBABILIDADE=0.62
DECISION_BLOQUEAR_RISCO_ELEVADO=true
FIXED_POSITION_PCT=1.5

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000

# Request/runtime hardening
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_HEAVY_MAX=20
CORS_ORIGINS=
OBSERVABILITY_LOGS=true

# Legacy/demo compatibility switches
GOOGLE_API_KEY=
AI_DEMO_MODE=false

# Server port
PORT=3000

# Runtime platform flags are normally supplied by the platform
NODE_ENV=
VERCEL=
