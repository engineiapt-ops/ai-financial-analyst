    "test:oos-policy": "tsx src/evaluation/oosPolicy.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "@vercel/oidc": "^3.8.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
