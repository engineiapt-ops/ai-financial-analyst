{
  "name": "ai-financial-analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "backtest": "tsx src/backtest/run.ts",
    "build": "tsc -p .",
    "lint": "tsc --noEmit",
    "start": "node dist/api/server.js",
    "test:indicators": "tsx src/features/indicators.test.ts",
