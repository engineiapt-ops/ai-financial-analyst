{
  "name": "ai-financial-analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "backtest": "tsx src/backtest/run.ts",
    "build": "tsc -p .",
    "lint": "tsc --noEmit",
    "start": "node dist/api/server.js",
    "test:indicators": "tsx src/features/indicators.test.ts",
    "test:sentiment": "tsx src/features/sentimentPipeline.test.ts",
    "test": "npm run test:indicators && npm run test:sentiment && npm run test:decision && npm run test:baseline && npm run test:paper",
    "test:decision": "tsx src/decision/decisionEngine.test.ts",
    "test:baseline": "tsx src/decision/baselineEngine.test.ts",
    "test:paper": "tsx src/papertrading/simulator.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
