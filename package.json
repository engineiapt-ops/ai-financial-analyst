    "test:decision": "tsx src/decision/decisionEngine.test.ts",
    "test:baseline": "tsx src/decision/baselineEngine.test.ts",
    "test:paper": "tsx src/papertrading/simulator.test.ts",
    "test:dataset": "tsx src/marketdata/dataset.test.ts",
    "test:repository": "tsx src/db/repository.test.ts",
    "test:server": "tsx src/api/server.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:pit": "tsx src/marketdata/pointInTime.test.ts",
    "market:backfill": "tsx src/marketdata/backfill.ts",
    "backtest:walk-forward": "tsx src/backtest/walkForward.ts",
    "test:research": "tsx src/research/report.test.ts",
    "test:snapshot": "tsx src/research/snapshot.test.ts",
    "test:evaluation": "tsx src/evaluation/decisionEvaluator.test.ts",
